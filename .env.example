# ==============================================================================
# PEARTONE STACK CONFIGURATION TEMPLATE
# Salin file ini menjadi .env (JANGAN COMMIT .env KE GIT)
# ==============================================================================

# Database Credentials
POSTGRES_USER=peartone_user
POSTGRES_PASSWORD=ganti_dengan_password_db_yang_kuat
POSTGRES_DB=peartone_db

# Security Secrets (Wajib diganti untuk production)
# Buat secret acak dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti_dengan_token_rahasia_minimal_32_karakter

# Google OAuth Credentials (Isi jika fitur login Google ingin digunakan)
# Jika kosong, server tetap berjalan menggunakan fallback dummy yang aman
GOOGLE_CLIENT_ID=ganti_dengan_google_client_id
GOOGLE_CLIENT_SECRET=ganti_dengan_google_client_secret

# URL Routing
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:3000
